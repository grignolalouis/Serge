{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["summary", "failure_taxonomy", "by_scenario", "by_level", "by_use_case", "metrics"],
  "properties": {
    "summary": {
      "type": "object",
      "properties": {
        "total_scenarios": { "type": "integer" },
        "total_runs": { "type": "integer" },
        "pass_rate": { "type": "number" },
        "avg_weighted_score": { "type": "number" },
        "hallucination_rate": { "type": "number" },
        "critical_facts_missing_rate": { "type": "number" },
        "functional_consistency_rate": { "type": "number" },
        "total_human_baseline_minutes": { "type": "number" },
        "total_agent_minutes": { "type": "number" },
        "total_time_saved_minutes": { "type": "number" },
        "avg_time_saved_pct_per_scenario": { "type": "number" },
        "avg_factual_accuracy": { "type": "number" },
        "avg_completeness": { "type": "number" },
        "avg_no_hallucination": { "type": "number" },
        "avg_reasoning": { "type": "number" }
      }
    },
    "failure_taxonomy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "count", "rate"],
        "properties": {
          "category": {
            "type": "string",
            "enum": ["none", "missed_fact", "wrong_value", "hallucination", "bad_reasoning", "refused"]
          },
          "count": { "type": "integer" },
          "rate": { "type": "number" }
        }
      }
    },
    "by_scenario": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario_id", "title", "level", "use_case", "avg_score", "pass_rate", "consistency_std", "functional_consistency", "runs"],
        "properties": {
          "scenario_id": { "type": "string" },
          "title": { "type": "string" },
          "level": { "type": "string" },
          "use_case": { "type": "string" },
          "expected_systems": { "type": "array", "items": { "type": "string" } },
          "expected_tool_count_min": { "type": "integer" },
          "estimated_human_minutes": { "type": "number" },
          "avg_score": { "type": "number" },
          "pass_rate": { "type": "number" },
          "consistency_std": { "type": "number" },
          "functional_consistency": { "type": "number" },
          "runs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "run": { "type": "integer" },
                "weighted_score": { "type": "number" },
                "pass": { "type": "boolean" },
                "critical_facts_present": { "type": "boolean" },
                "same_conclusion_as_ground_truth": { "type": "boolean" },
                "failure_category": { "type": "string" },
                "hallucination_count": { "type": "integer" },
                "duration_ms": { "type": "integer" },
                "tool_calls_count": { "type": "integer" },
                "tools_used": { "type": "array", "items": { "type": "string" } },
                "systems_touched": { "type": "array", "items": { "type": "string" } },
                "system_coverage": { "type": "number" },
                "tool_efficiency": { "type": "number" },
                "time_saved_pct": { "type": "number" },
                "cost_usd": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "by_level": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "scenario_count", "avg_score", "pass_rate", "avg_tool_calls", "avg_duration_ms"],
        "properties": {
          "level": { "type": "string" },
          "scenario_count": { "type": "integer" },
          "avg_score": { "type": "number" },
          "pass_rate": { "type": "number" },
          "avg_tool_calls": { "type": "number" },
          "avg_duration_ms": { "type": "number" },
          "avg_systems_touched": { "type": "number" },
          "avg_system_coverage": { "type": "number" },
          "avg_tool_efficiency": { "type": "number" },
          "avg_time_saved_pct": { "type": "number" }
        }
      }
    },
    "by_use_case": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "use_case": { "type": "string" },
          "scenario_count": { "type": "integer" },
          "avg_score": { "type": "number" },
          "pass_rate": { "type": "number" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["total_cost_usd", "total_duration_ms", "total_tool_calls"],
      "properties": {
        "total_cost_usd": { "type": "number" },
        "total_duration_ms": { "type": "integer" },
        "total_tool_calls": { "type": "integer" }
      }
    }
  }
}
